{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/snapshots/workshop-order.json",
  "title": "Snapshot d'une commande atelier (workshop_orders.snapshot)",
  "description": "Bon laboratoire figé à la création (L1D04) : code dossier patient uniquement (jamais nom, téléphone, antécédents ni prix), prescription versionnée, verres OD/OG, DP/hauteur et laboratoire. Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workshop_order_id",
    "reference",
    "lab_reference",
    "ordered_at",
    "expected_at",
    "quantity",
    "notes",
    "clinic",
    "patient",
    "supplier",
    "frame",
    "invoice_line",
    "prescription",
    "created_by",
    "template_version"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "workshop_order_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "lab_reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "ordered_at": {
      "$ref": "../schemas/common.json#/$defs/Instant"
    },
    "expected_at": {
      "$ref": "../schemas/common.json#/$defs/NullableInstant"
    },
    "quantity": {
      "$ref": "../schemas/common.json#/$defs/Quantity"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "clinic": {
      "description": "En-tête du cabinet au moment de l'émission ; test_document = true tant que production_documents_enabled est faux (document TEST clairement marqué, fichier 23).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clinic_id",
        "name",
        "address",
        "phone",
        "email",
        "tax_identifier",
        "professional_mentions",
        "document_settings",
        "currency",
        "timezone",
        "test_document"
      ],
      "properties": {
        "clinic_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "professional_mentions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "document_settings": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "$ref": "../schemas/common.json#/$defs/Currency"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "test_document": {
          "type": "boolean"
        }
      }
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_id",
        "record_number"
      ],
      "properties": {
        "patient_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplier_id",
        "name",
        "reference",
        "phone",
        "email"
      ],
      "properties": {
        "supplier_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "frame": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame_item_id",
            "reference",
            "name",
            "brand",
            "model"
          ],
          "properties": {
            "frame_item_id": {
              "$ref": "../schemas/common.json#/$defs/Ulid"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "brand": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "invoice_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_id",
        "invoice_number",
        "invoice_line_id",
        "description"
      ],
      "properties": {
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "invoice_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "invoice_line_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        }
      }
    },
    "prescription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prescription_id",
        "series_id",
        "version_no",
        "origin",
        "validated_at",
        "external_prescriber",
        "external_prescribed_on",
        "usage_code",
        "usage_label",
        "lens_type_code",
        "lens_type_label",
        "lens_index",
        "lens_index_label",
        "pd_total",
        "pd_od",
        "pd_og",
        "pd_inconsistency_reason",
        "notes",
        "treatments",
        "eyes"
      ],
      "properties": {
        "prescription_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "series_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "version_no": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "$ref": "../schemas/enums.json#/$defs/optical_prescriptions.origin"
        },
        "validated_at": {
          "$ref": "../schemas/common.json#/$defs/Instant"
        },
        "external_prescriber": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "external_prescribed_on": {
          "$ref": "../schemas/common.json#/$defs/NullableCivilDate"
        },
        "usage_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "lens_type_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "lens_type_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "lens_index": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]?)(\\.[0-9]{1,2})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lens_index_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "pd_total": {
          "$ref": "../schemas/common.json#/$defs/NullableDiopter"
        },
        "pd_od": {
          "$ref": "../schemas/common.json#/$defs/NullableDiopter"
        },
        "pd_og": {
          "$ref": "../schemas/common.json#/$defs/NullableDiopter"
        },
        "pd_inconsistency_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "treatments": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        },
        "eyes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eye",
              "sphere",
              "cylinder",
              "axis",
              "addition",
              "pd",
              "fitting_height",
              "lens_type",
              "lens_index",
              "treatments_snapshot",
              "frame_reference_snapshot"
            ],
            "properties": {
              "eye": {
                "$ref": "../schemas/enums.json#/$defs/workshop_order_eyes.eye"
              },
              "sphere": {
                "$ref": "../schemas/common.json#/$defs/NullableDiopter"
              },
              "cylinder": {
                "$ref": "../schemas/common.json#/$defs/NullableDiopter"
              },
              "axis": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 180
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "addition": {
                "$ref": "../schemas/common.json#/$defs/NullableDiopter"
              },
              "pd": {
                "$ref": "../schemas/common.json#/$defs/NullableDiopter"
              },
              "fitting_height": {
                "$ref": "../schemas/common.json#/$defs/NullableDiopter"
              },
              "lens_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "lens_index": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]?)(\\.[0-9]{1,2})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "treatments_snapshot": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              },
              "frame_reference_snapshot": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 2
        }
      }
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "display_name"
      ],
      "properties": {
        "user_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    },
    "template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
