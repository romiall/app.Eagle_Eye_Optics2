{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/resources/stock.json",
  "title": "Ressources : stock",
  "description": "Disponibilités, mouvements, stock initial, retours physiques, fournisseurs et réceptions. Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "$defs": {
    "StockAvailability": {
      "description": "Disponible central = physique − réservations centrales − quotas locaux non consommés (fichier 19).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "location_id",
        "stock_position_id",
        "on_hand",
        "reserved",
        "offline_allocated",
        "central_available",
        "lots"
      ],
      "properties": {
        "item_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "location_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "stock_position_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "on_hand": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
          "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
        },
        "reserved": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
          "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
        },
        "offline_allocated": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
          "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
        },
        "central_available": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
          "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
        },
        "lots": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lot_id",
              "batch_number",
              "expires_on",
              "status",
              "on_hand",
              "reserved",
              "offline_allocated"
            ],
            "properties": {
              "lot_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "batch_number": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "expires_on": {
                "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
              },
              "status": {
                "$ref": "../../schemas/enums.json#/$defs/stock_lots.status"
              },
              "on_hand": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
                "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
              },
              "reserved": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
                "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
              },
              "offline_allocated": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
                "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
              }
            }
          }
        }
      }
    },
    "StockAvailabilityPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/StockAvailability"
          }
        },
        "meta": {
          "$ref": "../../schemas/common.json#/$defs/Pagination"
        }
      }
    },
    "StockLocation": {
      "description": "Emplacement de stock (rayon, atelier, réserve) ; PRINCIPAL créé par eeo:sales:bootstrap.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "StockLocationList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/StockLocation"
          }
        }
      }
    },
    "StockMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "item_id",
        "position_id",
        "lot_id",
        "kind",
        "signed_quantity",
        "occurred_at",
        "reason",
        "approval_id"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "item_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "position_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "lot_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "kind": {
          "$ref": "../../schemas/enums.json#/$defs/stock_movements.kind"
        },
        "signed_quantity": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
          "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
        },
        "occurred_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approval_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        }
      }
    },
    "StockMovementResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/StockMovement"
        }
      }
    },
    "OpeningStockResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movements"
      ],
      "properties": {
        "movements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/StockMovement"
          }
        }
      }
    },
    "OpeningStockResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/OpeningStockResult"
        }
      }
    },
    "PhysicalReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "delivery_line_id",
        "item_id",
        "quantity",
        "condition_code",
        "accepted_for_restock",
        "occurred_at",
        "stock_movement_id",
        "credit_note_id"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "delivery_line_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "item_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "quantity": {
          "$ref": "../../schemas/common.json#/$defs/Quantity"
        },
        "condition_code": {
          "$ref": "../../schemas/enums.json#/$defs/physical_returns.condition_code"
        },
        "accepted_for_restock": {
          "type": "boolean"
        },
        "occurred_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "stock_movement_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "credit_note_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        }
      }
    },
    "PhysicalReturnResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/PhysicalReturn"
        }
      }
    },
    "Supplier": {
      "description": "Fournisseur ou laboratoire (L1D01) : coordonnées d'une entreprise ; il se désactive, il ne se supprime jamais.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "reference",
        "phone",
        "email",
        "address",
        "is_optical_lab",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "is_optical_lab": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "SupplierResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Supplier"
        }
      }
    },
    "SupplierList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Supplier"
          }
        }
      }
    },
    "GoodsReceiptSummary": {
      "description": "Réception fournisseur sans ses lignes (liste) : valeur au coût connu arrondie au FCFA par ligne, lignes sans coût comptées à part (jamais valorisées à zéro).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "supplier_id",
        "supplier_name",
        "location_id",
        "location_name",
        "supplier_reference",
        "received_at",
        "status",
        "validated_at",
        "notes",
        "line_count",
        "known_cost_total",
        "unknown_cost_lines"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "supplier_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "supplier_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "location_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "location_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "supplier_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "received_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/goods_receipts.status"
        },
        "validated_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "line_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "known_cost_total": {
          "$ref": "../../schemas/common.json#/$defs/MoneyXaf"
        },
        "unknown_cost_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "GoodsReceiptPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/GoodsReceiptSummary"
          }
        },
        "meta": {
          "$ref": "../../schemas/common.json#/$defs/Pagination"
        }
      }
    },
    "GoodsReceipt": {
      "description": "Réception fournisseur (L1D01) : brouillon sans lot, ou validée (lots, coûts confirmés, un mouvement RECEIPT par ligne). Une réception validée est définitive.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "supplier_id",
        "supplier_name",
        "location_id",
        "location_name",
        "supplier_reference",
        "received_at",
        "status",
        "validated_at",
        "notes",
        "line_count",
        "known_cost_total",
        "unknown_cost_lines",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "supplier_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "supplier_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "location_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "location_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "supplier_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "received_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/goods_receipts.status"
        },
        "validated_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "line_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "known_cost_total": {
          "$ref": "../../schemas/common.json#/$defs/MoneyXaf"
        },
        "unknown_cost_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "lines": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/GoodsReceiptLine"
          }
        }
      }
    },
    "GoodsReceiptLine": {
      "description": "Ligne de réception : coût unitaire connu ou null (inconnu, jamais zéro) ; lot renseigné à la validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "item_id",
        "item_reference",
        "item_name",
        "quantity",
        "unit_cost",
        "lot"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "item_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "item_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "item_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "quantity": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?$",
          "description": "DECIMAL(12,3) en chaîne exacte, zéro admis."
        },
        "unit_cost": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/MoneyXaf"
            },
            {
              "type": "null"
            }
          ]
        },
        "lot": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lot_id",
                "batch_number",
                "expires_on"
              ],
              "properties": {
                "lot_id": {
                  "$ref": "../../schemas/common.json#/$defs/Ulid"
                },
                "batch_number": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "expires_on": {
                  "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GoodsReceiptResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/GoodsReceipt"
        }
      }
    },
    "DeleteGoodsReceiptDraftResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "deleted"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "deleted": {
          "type": "boolean"
        }
      }
    },
    "DeleteGoodsReceiptDraftResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/DeleteGoodsReceiptDraftResult"
        }
      }
    }
  }
}
